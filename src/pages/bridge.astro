---
import type { Props } from "../components/Head.astro";
import Layout from "../layouts/Layout.astro";
import BridgeGame from "../components/bridge/BridgeGame.tsx";

const layoutProps: Props = {
  title: "Bridge",
  description:
    "Play a hand of contract bridge against three robots, then get a double dummy review of your bidding and your play.",
  path: "/bridge",
};
---

<Layout {...layoutProps} className="mx-auto w-full max-w-prose">
  {
    /*
    `prose` is scoped to the header rather than the page: it gives the title and
    the standfirst the same type and spacing as Blog and Reading, without its
    table and list rules reaching the game below.
  */
  }
  <header class="prose mb-6">
    <h1>Bridge</h1>
    {
      /*
      The standfirst is about the board in front of you, so the game hides it
      once the review takes over the page — see `INTRO_ID` in
      `BridgeGame.tsx`. It stays here rather than moving into the component so
      that it is server rendered with the title above it.
    */
    }
    <p id="bridge-intro">
      You sit South against three robots. Whenever your side buys the contract
      you play both hands, dummy's included; when the board is over, a double
      dummy solver reviews your bidding and your play.
    </p>
  </header>

  <BridgeGame client:only="solid-js" />

  <noscript>
    <p class="mt-6 border border-stone-200 bg-white/80 p-4 text-stone-700">
      This one needs JavaScript — the solver runs in your browser.
    </p>
  </noscript>
</Layout>
