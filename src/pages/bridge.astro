---
import type { Props } from "../components/Head.astro";
import Layout from "../layouts/Layout.astro";
import BridgeGame from "../components/bridge/BridgeGame.tsx";

const layoutProps: Props = {
  title: "Bridge",
  description:
    "Play a hand of contract bridge against three robots, then get a double dummy review of your bidding and your play.",
  path: "/bridge",
};
---

<Layout {...layoutProps} className="mx-auto w-full max-w-5xl">
  {
    /*
    `prose` is scoped to the header rather than the page: it gives the title and
    the standfirst the same type and spacing as Blog and Reading, without its
    table and list rules reaching the game below.
  */
  }
  <header class="prose mb-6">
    <h1>Bridge</h1>
    <p>
      You are South. The other three seats are robots that bid with a standard
      American system and choose cards by imagining deals consistent with what
      they have seen, solving each one exactly, and playing what wins the most
      tricks on average. They cannot see your hand. When the board is over you
      get a full double dummy review of the auction and the play.
    </p>
  </header>

  <BridgeGame client:only="solid-js" />

  <noscript>
    <p class="mt-6 border border-stone-200 bg-white/80 p-4 text-stone-700">
      This one needs JavaScript — the solver runs in your browser.
    </p>
  </noscript>
</Layout>
