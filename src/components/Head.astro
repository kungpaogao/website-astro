---
import { Font } from "astro:assets";
import {
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  SITE_NAME,
  composeTitle,
  ogImagePath,
} from "../lib/og";

export interface Props {
  title: string;
  description: string;
  path: string;
  imageUrl?: string;
}

const {
  title = SITE_NAME,
  description = `This is the website of ${SITE_NAME}`,
  path = "/",
  imageUrl,
} = Astro.props as Props;

const canonicalURL = new URL(path, Astro.site);
const fullTitle = composeTitle(title, path);

/**
 * Unless the page brought its own image, the preview is the one the `og-images`
 * integration renders for this route after the build. It is keyed off the URL
 * being rendered rather than the `path` prop, because collection entries take
 * `path` from Notion and it does not always match where they are served.
 */
const isGeneratedImage = imageUrl === undefined;
const socialImageUrl =
  imageUrl ?? new URL(ogImagePath(Astro.url.pathname), Astro.site).href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<title>{fullTitle}</title>
<link rel="canonical" href={canonicalURL} />

<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />

<!-- robots -->
<meta name="robots" content="index,follow" />
<meta name="googlebot" content="index,follow" />

<!-- apple -->
<meta name="apple-mobile-web-app-title" content="Gao" />
<meta name="apple-mobile-web-app-capable" content="yes" />

<!-- og -->
<meta property="og:locale" content="en_US" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:secure_url" content={socialImageUrl} />
<meta property="og:image:alt" content={fullTitle} />
{
  isGeneratedImage && (
    <Fragment>
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
      <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    </Fragment>
  )
}

<!-- twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:site" content="@ndrewgao" />
<meta property="twitter:creator" content="@ndrewgao" />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageUrl} />
<meta property="twitter:image:alt" content={fullTitle} />

<!-- styles and fonts -->
<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-newsreader" preload />
